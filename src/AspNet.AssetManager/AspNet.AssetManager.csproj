<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Authors>Baune8D</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Use Vite or Webpack with ASP.NET Core MVC and Razor Pages. Tag helpers that read your bundler's manifest and render script and link tags from the dev server in development and from hashed static files in production.</Description>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Baune8D/AspNet.AssetManager</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Baune8D/AspNet.AssetManager</PackageProjectUrl>
    <PackageTags>aspnetcore;mvc;razor;razor-pages;taghelpers;vite;webpack;frontend;assets;bundling;manifest;hmr</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/Baune8D/AspNet.AssetManager/releases</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>compile</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.IO.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
